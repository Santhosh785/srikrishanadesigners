---
// Bare layout for owner-only /admin/ pages: never indexed, no public nav,
// footer, analytics or structured data. Islands mount inside the slot.
import '../../styles/global.css';
import './admin.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#03275e" />
    <title>{title} | SKD Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="adm-body">
    <slot />
  </body>
</html>

---
// One dress in the catalogue grid. The whole card links to the dress page;
// the `quote` slot sits outside the link so a button can live there.
import type { Dress } from '../lib/dress-types';
import { dressPhotoUrl } from '../lib/dress-types';
import { categoryInfo } from '../lib/dresses';

interface Props {
  dress: Dress;
}
const { dress } = Astro.props;
const cover = dress.photos[0];
const coverUrl = cover ? dressPhotoUrl(cover.thumb || cover.path) : null;
const { label } = await categoryInfo(dress.category);
---

<article class="dress-card">
  <a class="dress-card-link" href={`/dresses/${dress.slug}/`}>
    {coverUrl && cover ? (
      <img
        src={coverUrl}
        alt={`${dress.name} – ${label}`}
        width={cover.w}
        height={cover.h}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="dress-card-placeholder" aria-hidden="true"></span>
    )}
    <h3>{dress.name}</h3>
    <small>{label}</small>
  </a>
  <!-- Quote button: opens QuoteDialog when the page mounts one, else links to the inline form. -->
  <slot name="quote">
    <a
      class="btn btn-outline dress-card-quote"
      href={`/dresses/${dress.slug}/#quote`}
      data-quote-open
      data-dress-id={dress.id}
      data-dress-slug={dress.slug}
      data-dress-name={dress.name}
      data-track="quote_open"
      aria-label={`Get a quote for ${dress.name}`}
    >Get a quote</a>
  </slot>
</article>

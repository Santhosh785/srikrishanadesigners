---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../site.config';
import { personSchema, breadcrumbSchema } from '../../lib/schema';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props as { author: CollectionEntry<'authors'> };
const d = author.data;
const posts = (await getPosts()).filter((p) => p.data.author.id === author.id);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
  { name: d.name, path: `/authors/${author.id}/` },
];
---

<BaseLayout
  title={`${d.name} — ${d.role}`}
  description={`${d.name}, ${d.role.toLowerCase()} at ${site.name}. ${d.bio}`.slice(0, 160)}
  schema={[
    personSchema({ slug: author.id, name: d.name, role: d.role, bio: d.bio }),
    breadcrumbSchema(crumbs),
  ]}
>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      {d.photo && <Image src={d.photo} alt={d.name} width={160} height={160} style="border-radius: 50%; margin: 24px 0 0;" />}
      <h1>{d.name}</h1>
      <p class="page-lede">
        {d.role}{d.yearsExperience ? ` · ${d.yearsExperience} years of experience` : ''}. {d.bio}
      </p>
    </div>
  </header>
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">Articles by <em>{d.name}</em></h2>
        <div class="card-grid">{posts.map((p) => <PostCard post={p} headingLevel="h3" />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

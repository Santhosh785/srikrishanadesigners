---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookCard from '../../components/BookCard.astro';
import { site, fullAddress } from '../../site.config';
import { breadcrumbSchema } from '../../lib/schema';
import { getServices } from '../../lib/content';

const services = await getServices();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title={`Book a Fitting — Contact ${site.name}`}
  description={`Book a consultation or fitting at ${site.name}, ${site.address.city}. Call ${site.phoneDisplay}, WhatsApp us, or send the booking form.`}
  schema={[
    breadcrumbSchema(crumbs),
    { '@type': 'ContactPage', url: Astro.url.href, about: { '@id': `${site.url}/#business` } },
  ]}
>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <h1>Book a <em>fitting.</em></h1>
      <p class="page-lede">
        Tell us what you'd like made and when you need it. We'll reply on WhatsApp or by phone to confirm
        your appointment. Studio: {fullAddress}. {site.hoursDisplay}.
      </p>
    </div>
  </header>

  <div class="container content-layout">
    <form class="booking-form" method="post" action="/api/booking/" data-booking-form>
      <div class="form-row">
        <label>Your name<input name="name" autocomplete="name" required maxlength="80" /></label>
        <label>Phone / WhatsApp<input name="phone" type="tel" autocomplete="tel" required pattern="[0-9+ ]{10,15}" /></label>
      </div>
      <div class="form-row">
        <label>
          Service
          <select name="service" required>
            {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
            <option value="Alterations">Alterations</option>
            <option value="Other">Something else</option>
          </select>
        </label>
        <label>Preferred date<input name="date" type="date" /></label>
      </div>
      <label>Occasion date (if any)<input name="occasion" type="date" /></label>
      <label>Anything we should know?<textarea name="message" maxlength="1000"></textarea></label>
      <div class="hp-field" aria-hidden="true">
        <label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button class="btn btn-primary" type="submit" data-track="book_form_submit">Request appointment</button>
      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </form>

    <aside>
      <BookCard heading="Prefer to chat?" message={`Hi ${site.name}, I'd like to book a fitting.`} showFormLink={false} />
    </aside>
  </div>

  {site.mapsEmbedUrl && (
    <div class="container" style="padding-bottom: 96px;">
      <iframe class="map-embed" src={site.mapsEmbedUrl} title={`Map to ${site.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
    </div>
  )}
</BaseLayout>

<script>
  // Progressive enhancement: without JS the form posts normally and the
  // endpoint redirects to /contact/thanks/.
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button');
    if (button) button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || 'Something went wrong.');
      window.location.href = '/contact/thanks/';
    } catch (err) {
      if (status) {
        status.dataset.state = 'error';
        status.textContent = `${(err as Error).message} Please call or WhatsApp us instead.`;
      }
      if (button) button.disabled = false;
    }
  });
</script>

---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolResultActions from '../../components/ToolResultActions.astro';
import { site } from '../../site.config';

// days before the wedding; `early` steps move two weeks earlier when 3+ outfits are being made.
const steps = [
  { days: 84, early: true, title: 'Shortlist designs and book a bridal consultation', detail: 'Save neck, sleeve and embroidery references. Bridal slots fill early in the muhurtham months.' },
  { days: 70, early: true, title: 'Buy sarees, lehenga fabric and blouse material', detail: 'Bring the saree to the consultation so the blouse colour, border and work can be matched.' },
  { days: 56, early: true, title: 'Measurements, final design and advance', detail: 'Heavy aari or maggam work starts now — it needs four to six weeks of hand embroidery.' },
  { days: 35, early: false, title: 'First trial fitting', detail: 'Wear the bra and innerwear you will wear on the day. Check the armholes, neck depth and back.' },
  { days: 21, early: false, title: 'Embroidery finished; second trial if needed', detail: 'Any fit changes after embroidery are made now, not in the final week.' },
  { days: 14, early: false, title: 'Final fitting with jewellery', detail: 'Try the necklaces and hair accessories with the neckline and back design.' },
  { days: 7, early: false, title: 'Collect every outfit and do a full try-on', detail: 'Check hooks, latkans and fall/pico. Keep a small repair kit ready.' },
  { days: 2, early: false, title: 'Steam, pack and hand over to your dresser', detail: 'Pack each outfit with its blouse, petticoat and accessories labelled by event.' },
];

const faqs = [
  {
    question: 'How early should I book a bridal blouse tailor?',
    answer: 'Book eight to twelve weeks before the wedding. Heavy aari or maggam work alone takes four to six weeks, and you need time for at least one trial and a final fitting. In the muhurtham months, book earlier still.',
  },
  {
    question: 'What if my wedding is less than six weeks away?',
    answer: 'It is still possible, but choose lighter hand embroidery or machine work, finalise the design at the first visit and plan fewer trials. Call us first so we can confirm the slot before you buy fabric.',
  },
  {
    question: 'How many trial fittings does a bridal blouse need?',
    answer: 'Usually two: one before or during embroidery to check the fit, and a final fitting about two weeks before the wedding. Weight changes before the wedding are common, so leave room for that final adjustment.',
  },
  {
    question: 'Does the plan change if I am stitching several outfits?',
    answer: 'Yes. With three or more outfits (muhurtham, reception, engagement and so on), start two weeks earlier so every outfit gets a proper trial. The planner adjusts the dates for you.',
  },
];
---

<ToolLayout
  name="Bridal timeline planner"
  title="Bridal Blouse Timeline Planner — When to Book Your Tailor"
  heading="Bridal outfit <em>timeline planner.</em>"
  description="Enter your wedding date and get a dated checklist for your bridal blouse and outfits — when to book, buy fabric, start aari work and schedule trials."
  answer="Start your bridal blouse about 12 weeks before the wedding: book the consultation and buy fabric by week 10, finalise the design and start aari or maggam work by week 8, then have trials at about 5 and 2 weeks before. Collect everything a week ahead."
  path="/tools/bridal-timeline-planner/"
  faqs={faqs}
  whatsappMessage={`Hi ${site.name}, I'd like to plan my bridal outfits.`}
>
  <div class="tool-grid">
    <form class="tool-inputs" data-planner onsubmit="return false">
      <label class="select-field">
        <span class="legend">Wedding date</span>
        <input type="date" name="wedding" required />
      </label>
      <label class="select-field">
        <span class="legend">Outfits being stitched</span>
        <select name="outfits">
          <option value="1">1 (muhurtham only)</option>
          <option value="2" selected>2 (muhurtham + reception)</option>
          <option value="3">3</option>
          <option value="4">4 or more</option>
        </select>
      </label>
      <p class="form-status" data-planner-warning role="status" aria-live="polite"></p>
    </form>

    <div class="tool-result">
      <div class="card result-card">
        <p class="eyebrow">Your plan</p>
        <ol class="timeline" data-timeline>
          {steps.map((s) => (
            <li data-days={s.days} data-early={s.early ? '1' : ''}>
              <time data-when>{s.days >= 7 ? `${Math.round(s.days / 7)} weeks before` : `${s.days} days before`}</time>
              <strong>{s.title}</strong>
              <span>{s.detail}</span>
            </li>
          ))}
        </ol>
        <p class="tool-summary visually-hidden-print" data-tool-summary hidden></p>
        <button type="button" class="btn btn-outline" style="margin-top: 16px; width: 100%;" data-ics disabled>Add to calendar (.ics)</button>
      </div>
      <ToolResultActions
        tool="bridal-planner"
        toolLabel="Bridal planning"
        intro={`Hi ${site.name}, I'm planning my bridal outfits. My timeline:`}
      />
    </div>
  </div>

  <Fragment slot="explainer">
    <h2 class="section-title">Why bridal blouses <em>need time.</em></h2>
    <div class="prose" style="max-width: 820px;">
      <p>
        A bridal blouse is usually the most detailed piece in a wedding wardrobe. Hand embroidery is slow, the
        fit has to be checked before and after the work, and most brides lose or gain a little weight in the
        final month. Building in two trials avoids last-minute alterations to finished embroidery.
      </p>
      <p>
        Read the full <a href="/blog/how-to-choose-a-bridal-tailor/">guide to choosing a bridal tailor</a>,
        compare <a href="/blog/how-long-does-aari-work-blouse-take/">how long aari work takes</a>, or see our
        <a href="/services/bridal-wear-lehenga/">bridal wear service</a>.
      </p>
    </div>
  </Fragment>
</ToolLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-planner]');
  const list = document.querySelector<HTMLOListElement>('[data-timeline]');
  const summary = document.querySelector<HTMLElement>('[data-tool-summary]');
  const warning = document.querySelector<HTMLElement>('[data-planner-warning]');
  const icsButton = document.querySelector<HTMLButtonElement>('[data-ics]');
  const fmt = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  const DAY = 86_400_000;

  let events: { date: Date; title: string }[] = [];

  const update = () => {
    if (!form || !list || !summary || !warning || !icsButton) return;
    const wedding = form.wedding.valueAsDate as Date | null;
    const outfits = Number(form.outfits.value);
    if (!wedding) return;

    const today = new Date(new Date().toDateString());
    const daysLeft = Math.round((wedding.getTime() - today.getTime()) / DAY);
    events = [];

    for (const li of list.querySelectorAll<HTMLLIElement>('li')) {
      const days = Number(li.dataset.days) + (li.dataset.early && outfits >= 3 ? 14 : 0);
      let date = new Date(wedding.getTime() - days * DAY);
      const overdue = date < today;
      if (overdue) date = today;
      li.classList.toggle('overdue', overdue);
      li.querySelector('[data-when]')!.textContent = overdue ? 'As soon as possible' : fmt.format(date);
      events.push({ date, title: li.querySelector('strong')!.textContent ?? '' });
    }

    warning.dataset.state = daysLeft < 42 ? 'error' : 'ok';
    warning.textContent =
      daysLeft < 0 ? 'That date has passed — please check it.'
      : daysLeft < 42 ? `Only ${daysLeft} days left: choose lighter work and call us before buying fabric.`
      : `${daysLeft} days to go — comfortable for detailed hand work.`;

    summary.hidden = false;
    summary.textContent = [
      `Wedding: ${fmt.format(wedding)} (${outfits} outfit${outfits > 1 ? 's' : ''})`,
      ...events.map((e) => `${fmt.format(e.date)} — ${e.title}`),
    ].join('\n');
    icsButton.disabled = false;
  };

  const ics = () => {
    const d = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '');
    const body = [
      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Sri Krishna Designers//Bridal planner//EN',
      ...events.flatMap((e, i) => [
        'BEGIN:VEVENT',
        `UID:skd-bridal-${d(e.date)}-${i}@srikrishnadesigners`,
        `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').slice(0, 15)}Z`,
        `DTSTART;VALUE=DATE:${d(e.date)}`,
        `SUMMARY:${e.title.replace(/[,;]/g, ' ')}`,
        'END:VEVENT',
      ]),
      'END:VCALENDAR',
    ].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([body], { type: 'text/calendar' }));
    a.download = 'bridal-outfit-plan.ics';
    a.click();
    URL.revokeObjectURL(a.href);
  };

  form?.addEventListener('change', update);
  form?.addEventListener('input', update);
  icsButton?.addEventListener('click', ics);
</script>

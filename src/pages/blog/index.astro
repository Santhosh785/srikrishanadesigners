---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../site.config';
import { breadcrumbSchema } from '../../lib/schema';
import { getPosts, tagSlug } from '../../lib/content';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/blog/' },
];
---

<BaseLayout
  title="Tailoring Journal: Blouse, Bridal & Fitting Advice"
  description={`Practical guides from ${site.name} on blouse designs, bridal wear planning, measurements, fabrics and stitching costs.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <h1>Tailoring <em>journal.</em></h1>
      <p class="page-lede">
        Straight answers to the questions our clients ask most — from what a bridal blouse costs to how
        to measure yourself at home.
      </p>
      {tags.length > 0 && (
        <ul class="tag-list" style="margin-top: 24px;">
          {tags.map((t) => <li><a href={`/blog/tag/${tagSlug(t)}/`}>{t}</a></li>)}
        </ul>
      )}
    </div>
  </header>

  <section class="section">
    <div class="container">
      {posts.length > 0
        ? <div class="card-grid">{posts.map((post) => <PostCard post={post} />)}</div>
        : <p class="empty-note">New articles are on their way.</p>}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostCard from '../../../components/PostCard.astro';
import { site } from '../../../site.config';
import { breadcrumbSchema } from '../../../lib/schema';
import { getPosts, tagSlug, type Post } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
const path = `/blog/tag/${tagSlug(tag)}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/blog/' },
  { name: tag, path },
];
const label = tag.charAt(0).toUpperCase() + tag.slice(1);
---

<BaseLayout
  title={`${label} — Articles`}
  description={`Articles about ${tag} from ${site.name}: practical tailoring advice, designs and fitting tips.`}
  noindex={posts.length < 2}
  schema={[breadcrumbSchema(crumbs)]}
>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{label}</h1>
      <p class="page-lede">{posts.length} article{posts.length === 1 ? '' : 's'} tagged “{tag}”.</p>
    </div>
  </header>
  <section class="section">
    <div class="container card-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

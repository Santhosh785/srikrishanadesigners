# --- Build time (Coolify: mark as "Build Variable") ---
# true on staging: adds noindex everywhere and robots.txt disallows all.
SITE_NOINDEX=false

# --- Coolify: build + runtime variable (public, shipped to the browser) ---
# Supabase project URL and anon key for the dress catalogue.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Runtime (Coolify: normal env vars) ---
# Google Apps Script web-app URL that appends booking rows to the Sheet.
BOOKING_SHEET_WEBHOOK_URL=

# --- Coolify: runtime only (secrets, never build variables) ---
# Supabase service-role key; server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# RelayOne WhatsApp alert to the owner. All four are optional:
# the alert is skipped when any is missing.
RELAYONE_API_URL=
RELAYONE_API_KEY=
RELAYONE_TEMPLATE=
OWNER_WHATSAPP=

# Keystatic GitHub mode (filled by the Keystatic GitHub App setup flow).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
